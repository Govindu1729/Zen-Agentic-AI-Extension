{
  "manifest_version": 2,
  "name": "Zen Agentic AI",
  "version": "0.1.0",
  "description": "Agentic AI integration for Zen Browser with MCP, screen capture, and local ML",
  "author": "Zen Agentic Team",
  "homepage_url": "https://github.com/zen-agentic-extension",

  "sidebar_action": {
    "default_title": "Zen Agentic AI",
    "default_panel": "sidebar.html",
    "open_at_install": false
  },

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "nativeMessaging",
    "webRequest",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "native_applications": {
    "zen_agentic_native": {
      "path": "/Users/srimaan/Projects/zen-extension/native-host/target/release/zen-agentic-native",
      "allowed_extensions": ["zen-agentic-ai@localhost"]
    }
  },



  "browser_specific_settings": {
    "gecko": {
      "id": "zen-agentic-ai@localhost",
      "strict_min_version": "109.0"
    }
  }
}
